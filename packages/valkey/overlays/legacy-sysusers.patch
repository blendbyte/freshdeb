diff -ruN a/debian/valkey-tools.postinst b/debian/valkey-tools.postinst
--- a/debian/valkey-tools.postinst
+++ b/debian/valkey-tools.postinst
@@ -0,0 +1,35 @@
+#!/bin/sh
+
+set -eu
+
+# freshdeb: debhelper on this release has no dh_installsysusers, so the
+# system user and its directories are created here, as Debian did before
+# valkey 9.1. Directories with a dpkg-statoverride are left alone.
+
+Setup_dir () {
+	DIR="${1}"
+	MODE="${2}"
+	GROUP="${3}"
+
+	mkdir -p "${DIR}"
+
+	if ! dpkg-statoverride --list "${DIR}" >/dev/null 2>&1
+	then
+		chown "valkey:${GROUP}" "${DIR}"
+		chmod "${MODE}" "${DIR}"
+	fi
+}
+
+if [ "$1" = "configure" ]
+then
+	adduser --system --group --home /var/lib/valkey --no-create-home \
+		--quiet valkey || true
+
+	Setup_dir /var/log/valkey 2750 adm
+	Setup_dir /var/lib/valkey 750 valkey
+	Setup_dir /etc/valkey 2770 valkey
+fi
+
+#DEBHELPER#
+
+exit 0
