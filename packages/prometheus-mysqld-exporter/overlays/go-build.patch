--- a/debian/NEWS
+++ b/debian/NEWS
@@ -0,0 +1,44 @@
+prometheus-mysqld-exporter (0.21.0-1) unstable; urgency=medium
+
+  freshdeb: selected mysql_global_status_* and mysql_slave_status_* metrics
+  (query and table cache totals, threads, uptime, replica running and lag)
+  are now typed as counters or gauges instead of untyped. Queries keep
+  working; check rules or tools that look at metric types.
+
+ -- freshdeb <packages@freshdeb.com>  Wed, 28 Oct 2026 12:00:00 +0000
+
+prometheus-mysqld-exporter (0.15.0-1) unstable; urgency=medium
+
+  freshdeb: mysqld_exporter 0.15 no longer reads DATA_SOURCE_NAME. If you
+  set it in /etc/default/prometheus-mysqld-exporter, the exporter does not
+  start: it logs that DATA_SOURCE_NAME is ignored, and that it found no
+  configuration. Move the credentials to /var/lib/prometheus/.my.cnf, owned
+  by and readable only by the prometheus user:
+
+    [client]
+    user = prometheus
+    password = secret
+    socket = /run/mysqld/mysqld.sock
+
+  or use host and port instead of socket for TCP. A file elsewhere works
+  with --config.my-cnf=<file> in ARGS. /etc/default/prometheus-mysqld-exporter
+  documents the other settings.
+
+  /var/lib/prometheus/.my.cnf, the prometheus user's ~/.my.cnf, stays the
+  default file this package reads (upstream's default since 0.15 is .my.cnf
+  in the working directory), so setups that already used it keep working.
+
+  The scrape metrics mysql_exporter_scrapes_total,
+  mysql_exporter_scrape_errors_total and mysql_last_scrape_failed are gone;
+  mysql_up and mysql_exporter_collector_success are what is left.
+
+ -- freshdeb <packages@freshdeb.com>  Wed, 28 Oct 2026 12:00:00 +0000
+
+prometheus-mysqld-exporter (0.14.0-1) unstable; urgency=medium
+
+  freshdeb: the metrics of the info_schema.processlist and
+  info_schema.replica_host collectors were renamed in mysqld_exporter 0.14.
+  Both collectors are off by default; if you enabled them, update queries,
+  rules and dashboards that use their metrics.
+
+ -- freshdeb <packages@freshdeb.com>  Wed, 28 Oct 2026 12:00:00 +0000
diff -ruN a/debian/rules b/debian/rules
--- a/debian/rules
+++ b/debian/rules
@@ -4,34 +4,38 @@
 # Uncomment this to turn on verbose mode.
 #export DH_VERBOSE=1
 
-export DH_GOLANG_INSTALL_EXTRA := test_exporter.cnf
+# freshdeb: built with a pinned Go toolchain and vendored, checksum-verified
+# modules instead of dh-golang and Debian's golang-* packages, which older
+# releases don't have, with the flags and version stamps of upstream's
+# release binaries. The toolchain, offline mode (GOFLAGS=-mod=vendor,
+# GOPROXY=off) and caches come from the build environment.
+export CGO_ENABLED := 0
 
 BUILDDIR := build
 METAPKG := github.com/prometheus/common
 
-BRANCH     := debian/sid
-USER       := team+pkg-go@tracker.debian.org
+# The upstream commit, from the changelog entry freshdeb adds.
+REVISION   := $(or $(shell sed -n '1,/^ -- /s/.*(commit \([0-9a-f]\{40\}\)).*/\1/p' debian/changelog),$(DEB_VERSION))
 BUILD_DATE  = $(shell date --utc --date='@$(SOURCE_DATE_EPOCH)' \
     +%Y%m%d-%H:%M:%S)
-GO_VERSION  = $(shell go version | sed 's/go version \(\S*\).*/\1/')
 BUILDFLAGS  = -ldflags \
   " -X $(METAPKG)/version.Version=$(DEB_VERSION_UPSTREAM)\
-    -X $(METAPKG)/version.Revision=$(DEB_VERSION)\
-    -X $(METAPKG)/version.Branch=$(BRANCH)\
-    -X $(METAPKG)/version.BuildUser=$(USER)\
-    -X $(METAPKG)/version.BuildDate=$(BUILD_DATE)\
-    -X $(METAPKG)/version.GoVersion=$(GO_VERSION)"
+    -X $(METAPKG)/version.Revision=$(REVISION)\
+    -X $(METAPKG)/version.Branch=HEAD\
+    -X $(METAPKG)/version.BuildUser=freshdeb\
+    -X $(METAPKG)/version.BuildDate=$(BUILD_DATE)"
 
 %:
-	dh $@ --buildsystem=golang --builddirectory=$(BUILDDIR)
+	dh $@
 
 BINNAME := $(DEB_SOURCE)
 WHATIS := "$(BINNAME) \\- Prometheus exporter for MySQL/MariaDB"
 
+override_dh_auto_configure:
+
 override_dh_auto_build:
-	dh_auto_build -- $(BUILDFLAGS)
-	# Rename the binary to match the debian package.
-	mv -v $(BUILDDIR)/bin/mysqld_exporter $(BUILDDIR)/bin/$(BINNAME)
+	go version
+	go build $(BUILDFLAGS) -o $(BUILDDIR)/bin/$(BINNAME) .
 	$(BUILDDIR)/bin/$(BINNAME) --help-man > $(BUILDDIR)/$(BINNAME).1
 	# Remove build user/build date/go version headers, which is ugly.
 	sed -i -e '/^  /d' $(BUILDDIR)/$(BINNAME).1
@@ -40,5 +44,18 @@
 	# Remove default values as they create unwieldy long lines.
 	sed -i 's/\\fB--\(.*\)=".*"\\fR/\\fB--\1\\fR/' $(BUILDDIR)/$(BINNAME).1
 
+# Upstream's test suite, as upstream's "make test" runs it. It needs no
+# database: the collectors are tested against sqlmock.
+override_dh_auto_test:
+ifeq (,$(filter nocheck,$(DEB_BUILD_OPTIONS)))
+	go test -short $(BUILDFLAGS) ./...
+endif
+
 override_dh_auto_install:
-	dh_auto_install -- --no-source
+	install -D -m 0755 $(BUILDDIR)/bin/$(BINNAME) debian/prometheus-mysqld-exporter/usr/bin/$(BINNAME)
+
+# Go binary: nothing for dwz to compress.
+override_dh_dwz:
+
+override_dh_auto_clean:
+	rm -rf $(BUILDDIR)
