#!/bin/sh
set -e

case "$1" in
  configure)
    # The services run as frp; the configuration holds the auth token, so
    # only root and frp can read it.
    adduser --quiet --system --group --no-create-home --home /nonexistent frp
    if ! dpkg-statoverride --list /etc/frp/frps.toml >/dev/null; then
      chown root:frp /etc/frp/frps.toml
      chmod 0640 /etc/frp/frps.toml
    fi
  ;;

  abort-upgrade|abort-remove|abort-deconfigure)
  ;;

  *)
    echo "postinst called with unknown argument '$1'" >&2
    exit 1
  ;;
esac

#DEBHELPER#

exit 0
