diff -ruN a/debian/postsrsd.maintscript b/debian/postsrsd.maintscript
--- a/debian/postsrsd.maintscript
+++ b/debian/postsrsd.maintscript
@@ -0,0 +1 @@
+rm_conffile /etc/apparmor.d/usr.sbin.postsrsd 2.4.1-3~
diff -ruN a/debian/postsrsd.preinst b/debian/postsrsd.preinst
--- a/debian/postsrsd.preinst
+++ b/debian/postsrsd.preinst
@@ -0,0 +1,22 @@
+#!/bin/sh
+
+set -e
+
+# freshdeb: postsrsd 1.x shipped an AppArmor profile, which Debian's 2.x
+# packages kept loading as an obsolete conffile. 2.x has none and the old
+# one doesn't fit it, so unload it here, while it is still in place
+# (rm_conffile in postsrsd.maintscript moves it aside below), and drop
+# what went with it.
+if [ "$1" = install ] || [ "$1" = upgrade ]; then
+	if dpkg --compare-versions "$2" lt-nl 2.4.1-3~; then
+		PROFILE=/etc/apparmor.d/usr.sbin.postsrsd
+		if [ -f $PROFILE ] && [ -x /sbin/apparmor_parser ] && aa-status --enabled 2>/dev/null; then
+			apparmor_parser -R $PROFILE 2>/dev/null || true
+		fi
+		rm -f /etc/apparmor.d/disable/usr.sbin.postsrsd /etc/apparmor.d/force-complain/usr.sbin.postsrsd
+		rm -f /var/cache/apparmor/*/usr.sbin.postsrsd
+		[ -s /etc/apparmor.d/local/usr.sbin.postsrsd ] || rm -f /etc/apparmor.d/local/usr.sbin.postsrsd
+	fi
+fi
+
+#DEBHELPER#
diff -ruN a/debian/rules b/debian/rules
--- a/debian/rules
+++ b/debian/rules
