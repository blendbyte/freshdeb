+	dh_auto_configure --buildsystem=cmake -- -DCMAKE_BUILD_TYPE=Release -DGENERATE_SRS_SECRET=OFF -DPOSTSRSD_USER=postsrsd -DTESTS_WITH_ASAN=OFF -DCHROOT_DIR=/var/lib/postsrsd -DFETCHCONTENT_TRY_FIND_PACKAGE_MODE=ALWAYS
