#. Type: string
#. Description
#: ../postsrsd.templates:2001
msgid "Local domain name to use as origin:"
msgstr "Nazwa domeny źródłowej serwera poczty:"

#. Type: string
#. Description
#: ../postsrsd.templates:2001
msgid ""
"Please enter the domain name to use in rewritten addresses of forwarded "
"mail. The SPF policy for that domain should allow this mail server to send "
"mail."
msgstr ""
"Wprowadź proszę nazwę domeny do użycia w nadpisanych adresach nadawcy "
"przekazanych wiadomości. Polityka SPF tej domeny powinna pozwalać "
"niniejszemu serwerowi poczty na wysyłanie wiadomości."

#. Type: string
#. Description
#: ../postsrsd.templates:2001
msgid "Without a configured local domain name, postsrsd will not start."
msgstr "Bez skonfigurowanej domeny, postsrsd nie uruchomi się."

#~ msgid ""
#~ "Addresses of forwarded mail are rewritten to originate from this domain "
#~ "name. This domain should have an SPF policy that allows mail to be send "
#~ "from this mailserver."
#~ msgstr ""
#~ "Adres nadawcy przekazywanych wiadomości będzie nadpisywany tak, by "
#~ "sprawiał wrażenie, że pochodzi z tej domeny. Domena ta powinna mieć "
#~ "ustawioną politykę SPF, która pozwala na wysyłanie z tego serwera poczty."
