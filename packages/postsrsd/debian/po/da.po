#. Type: string
#. Description
#: ../postsrsd.templates:2001
msgid "Local domain name to use as origin:"
msgstr "Lokal domænenavn at bruge som oprindelse:"

#. Type: string
#. Description
#: ../postsrsd.templates:2001
msgid ""
"Please enter the domain name to use in rewritten addresses of forwarded "
"mail. The SPF policy for that domain should allow this mail server to send "
"mail."
msgstr ""
"Indtast venligst domænenavnet at bruge i omskrevne adresser for videresendt "
"post. SPF-politikken for det domæne skal tillade at denne postserver sender "
"post."

#. Type: string
#. Description
#: ../postsrsd.templates:2001
msgid "Without a configured local domain name, postsrsd will not start."
msgstr "Uden et konfigureret lokalt domænenavn vil postsrsd ikke starte."
