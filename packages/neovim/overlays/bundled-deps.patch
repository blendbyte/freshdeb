+# freshdeb: build with neovim's bundled dependencies (libuv, LuaJIT, luv,
+# lpeg, unibilium, utf8proc, tree-sitter and its parsers) on every release,
+# as upstream's release builds do; older releases lack them or have them too
+# old. hooks/prefetch-deps.py put their sources, verified against the
+# sha256s in cmake.deps/deps.txt, into .deps/build/downloads. Nothing is
+# downloaded here: these proxy settings make any attempt fail.
+export http_proxy = http://127.0.0.1:9
+export https_proxy = http://127.0.0.1:9
 
-BUILD_TYPE=Release
+BUILD_TYPE = Release
 ifneq (,$(filter noopt,$(DEB_BUILD_OPTIONS)))
-  BUILD_TYPE=Debug
