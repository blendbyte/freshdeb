-			fs := server.StaticFileServer(ui.Assets)
-			fs.ServeHTTP(w, r)
+			http.ServeFile(w, r, filepath.Join(o.LocalAssets, "static/react", p))
 		})
 	}
 
-	reactStaticAssetsDir := "/assets"
-	if h.options.UseOldUI {
