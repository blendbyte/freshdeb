-	UseLocalAssets             bool
+	LocalAssets                string
 	UserAssetsPath             string
 	ConsoleTemplatesPath       string
 	ConsoleLibrariesPath       string
@@ -422,17 +422,13 @@ func New(logger *slog.Logger, o *Options) *Handler {
 		})
 	}
 
-	reactAssetsRoot := "/static/mantine-ui"
