diff -ruN a/debian/prometheus.postinst b/debian/prometheus.postinst
--- a/debian/prometheus.postinst
+++ b/debian/prometheus.postinst
@@ -0,0 +1,25 @@
+#!/bin/sh
+
+set -e
+
+# freshdeb: debhelper on this release has no dh_installsysusers and only
+# applies tmpfiles rules when systemd is running, so the system user and
+# its directories are created here, as Debian did before Prometheus 3.
+# Directories with a dpkg-statoverride are left alone.
+
+if [ "$1" = "configure" ]; then
+    adduser --system --group --home /var/lib/prometheus --no-create-home \
+        --gecos "Prometheus daemon" --quiet prometheus || true
+
+    for dir in /var/lib/prometheus /var/lib/prometheus/metrics2; do
+        mkdir -p "$dir"
+        if ! dpkg-statoverride --list "$dir" >/dev/null 2>&1; then
+            chown prometheus:prometheus "$dir"
+        fi
+    done
+    mkdir -p /var/log/prometheus
+fi
+
+#DEBHELPER#
+
+exit 0
