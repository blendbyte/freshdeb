+# freshdeb: built with a pinned Go toolchain and vendored, checksum-verified
+# modules instead of dh-golang and Debian's golang-* packages, which older
+# releases don't have. That also brings back everything Debian has to
+# disable for lack of packaged libraries (xDS, Consul, Nomad, Azure,
+# OpenStack and StackIT service discovery, Azure AD, OTLP ingestion), and
+# the web UI: upstream's prebuilt release assets, pinned by sha256 in
+# package.yaml, embedded the way upstream's release build does. Same tags
+# and version stamps as upstream's binaries. The toolchain, offline mode
+# (GOFLAGS=-mod=vendor, GOPROXY=off) and caches come from the build
+# environment.
+export CGO_ENABLED := 0
 
 BUILDDIR   := $(CURDIR)/.build
-PKG        := github.com/prometheus/prometheus
 METAPKG    := github.com/prometheus/common
 
-BRANCH     := debian/sid
-USER       := team+pkg-go@tracker.debian.org
+# The upstream commit, from the changelog entry freshdeb adds.
+REVISION   := $(or $(shell sed -n '1,/^ -- /s/.*(commit \([0-9a-f]\{40\}\)).*/\1/p' debian/changelog),$(DEB_VERSION))
 BUILD_DATE  = $(shell date --utc --date='@$(SOURCE_DATE_EPOCH)' \
     +%Y%m%d-%H:%M:%S)
-GO_VERSION  = $(shell go version | sed 's/go version \(\S*\).*/\1/')
-BUILDFLAGS  = -ldflags \
+GOFLAGS_BUILD = -tags netgo,builtinassets -ldflags \
   " -X $(METAPKG)/version.Version=$(DEB_VERSION_UPSTREAM)\
-    -X $(METAPKG)/version.Revision=$(DEB_VERSION)\
-    -X $(METAPKG)/version.Branch=$(BRANCH)\
-    -X $(METAPKG)/version.BuildUser=$(USER)\
-    -X $(METAPKG)/version.BuildDate=$(BUILD_DATE)\
-    -X $(METAPKG)/version.GoVersion=$(GO_VERSION)"
-
-ifeq ($(DEB_HOST_ARCH_CPU),arm)
-  # Tests in armel take way too long, and run out of memory in armhf.
-  TESTFLAGS := -timeout 60m -short
-else ifeq ($(DEB_HOST_ARCH_CPU),mips64el)
-  # mips64el is also super slow
-  TESTFLAGS := -timeout 60m -short
-else ifeq ($(DEB_HOST_ARCH_CPU),riscv64)
-  # Override gcflags to workaround https://github.com/golang/go/issues/63167
-  TESTFLAGS := -timeout 60m -short -gcflags=all=-d=wrapglobalmapctl=1
-else
-  TESTFLAGS := -timeout 60m
-endif
+    -X $(METAPKG)/version.Revision=$(REVISION)\
+    -X $(METAPKG)/version.Branch=HEAD\
+    -X $(METAPKG)/version.BuildUser=freshdeb\
+    -X $(METAPKG)/version.BuildDate=$(BUILD_DATE)"
 
