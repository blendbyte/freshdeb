#!/bin/sh
set -e

case "$1" in
  purge)
    # As upstream's .deb (packaging/deb/postrm): purging removes the user
    # and the data, the SQLite database included.
    if id -u headscale >/dev/null 2>&1; then
      userdel headscale || true
    fi
    rm -rf /var/lib/headscale
  ;;

  remove|upgrade|failed-upgrade|abort-install|abort-upgrade|disappear)
  ;;

  *)
    echo "postrm called with unknown argument '$1'" >&2
    exit 1
  ;;
esac

#DEBHELPER#

exit 0
