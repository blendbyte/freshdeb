# Upstream's extras/startup/unrealircd.service, with the package's paths and
# user, the directories it writes to, and no start until it's configured.
# Forking, not upstream's "-F": in the foreground the server copies every log
# event to stderr, whatever its log blocks say, which fills the journal (and
# syslog). Forked, it writes only the boot messages there (configuration
# errors among them), then logs as configured. It also forks only once the
# configuration is loaded and the listeners are open, so "systemctl start"
# fails on a bad configuration instead of succeeding first.
# Upstream's ExecReload/ExecStop run /bin/kill, which minimal systems don't
# have (procps): reload rehashes over the control socket instead, which also
# fails the reload when the configuration does, and stop is systemd's own
# SIGTERM, which is all upstream's ExecStop sent.
[Unit]
Description=UnrealIRCd IRC server
Documentation=https://www.unrealircd.org/docs/ file:/usr/share/doc/unrealircd/README.Debian
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/unrealircd/unrealircd.conf

[Service]
Type=forking
User=unrealircd
Group=unrealircd
ExecStart=/usr/sbin/unrealircd
PIDFile=/run/unrealircd/unrealircd.pid
ExecReload=/usr/sbin/unrealircdctl rehash
Restart=on-failure
RestartSec=5s
LimitNOFILE=65536
UMask=0027

RuntimeDirectory=unrealircd
StateDirectory=unrealircd unrealircd/tmp
StateDirectoryMode=0750
CacheDirectory=unrealircd
CacheDirectoryMode=0750
LogsDirectory=unrealircd
LogsDirectoryMode=0750

NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictRealtime=true

[Install]
WantedBy=multi-user.target
