+
+# freshdeb: composer.phar built from the release's source the way upstream
+# builds it (bin/compile), instead of Composer's sources installed against
+# Debian's php-* libraries, which older releases don't have in the versions
+# Composer needs. The dependencies are the ones in upstream's composer.lock,
+# each extracted from its locked git commit by the prepare hook
+# (hooks/vendor-deps.py); debian/freshdeb-bootstrap.php sets them up for
+# "composer install", run from the source itself. Composer runs offline
+# here, with its home inside the build tree.
+export COMPOSER_HOME := $(CURDIR)/debian/.composer
+export COMPOSER_DISABLE_NETWORK := 1
+export COMPOSER_NO_INTERACTION := 1
+# The version of the source tree (no git to tell), as in upstream's build.
+export COMPOSER_ROOT_VERSION := $(UPSTREAM)
+# The release's commit date (from the prepare hook), which upstream's phar
+# shows in "composer --version" and uses for its file timestamps.
+RELEASE_DATE := $(shell cat freshdeb-release-date)
+RELEASE_TS := $(shell date --utc --date='$(RELEASE_DATE)' +%s)
+# The upstream commit, from the changelog entry freshdeb adds.
+REVISION := $(shell sed -n '1,/^ -- /s/.*(commit \([0-9a-f]\{40\}\)).*/\1/p' debian/changelog)
