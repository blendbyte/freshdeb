diff -ruN a/debian/freshdeb-bootstrap.php b/debian/freshdeb-bootstrap.php
--- a/debian/freshdeb-bootstrap.php
+++ b/debian/freshdeb-bootstrap.php
@@ -0,0 +1,70 @@
+<?php
+/*
+ * freshdeb: set up vendor/ for "composer install", which then records the
+ * installed packages and writes the real autoloader (debian/rules).
+ *
+ * The prepare hook put the dependencies from composer.lock in vendor/, each
+ * extracted from its locked git commit. This writes what "composer install"
+ * would have recorded about them, vendor/composer/installed.json, and a
+ * temporary vendor/autoload.php that loads Composer's own sources and the
+ * dependencies by their autoload rules, enough to run bin/composer.
+ */
+
+$root = dirname(__DIR__);
+$vendor = $root.'/vendor';
+$lock = json_decode(file_get_contents($root.'/composer.lock'), true, 512, JSON_THROW_ON_ERROR);
+
+$packages = [];
+foreach ($lock['packages'] as $package) {
+    if (!is_dir($vendor.'/'.$package['name'])) {
+        fwrite(STDERR, "missing from vendor/: {$package['name']}\n");
+        exit(1);
+    }
+    $package['installation-source'] = 'dist';
+    $package['install-path'] = '../'.$package['name'];
+    $packages[] = $package;
+}
+@mkdir($vendor.'/composer', 0777, true);
+file_put_contents(
+    $vendor.'/composer/installed.json',
+    json_encode(['packages' => $packages, 'dev' => false, 'dev-package-names' => []], JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE)."\n"
+);
+
+file_put_contents($vendor.'/autoload.php', <<<'PHP'
+<?php
+// freshdeb: temporary, until "composer install" replaces it.
+require_once __DIR__.'/../src/Composer/Autoload/ClassLoader.php';
+
+$loader = new \Composer\Autoload\ClassLoader(__DIR__);
+$loader->addPsr4('Composer\\', __DIR__.'/../src/Composer/');
+$installed = json_decode(file_get_contents(__DIR__.'/composer/installed.json'), true);
+$files = [];
+foreach ($installed['packages'] as $package) {
+    $dir = __DIR__.'/'.$package['name'].'/';
+    foreach ($package['autoload']['psr-4'] ?? [] as $prefix => $paths) {
+        $loader->addPsr4($prefix, array_map(function ($path) use ($dir) { return $dir.$path; }, (array) $paths));
+    }
+    foreach ($package['autoload']['psr-0'] ?? [] as $prefix => $paths) {
+        $loader->add($prefix, array_map(function ($path) use ($dir) { return $dir.$path; }, (array) $paths));
+    }
+    foreach ($package['autoload']['files'] ?? [] as $file) {
+        $files[] = $dir.$file;
+    }
+    // Here only the polyfills' stubs, one class per file named after it.
+    foreach ($package['autoload']['classmap'] ?? [] as $path) {
+        $stubs = is_dir($dir.$path) ? glob($dir.rtrim($path, '/').'/*.php') : [$dir.$path];
+        foreach ($stubs as $stub) {
+            $loader->addClassMap([basename($stub, '.php') => $stub]);
+        }
+    }
+}
+$loader->register(true);
+foreach ($files as $file) {
+    require_once $file;
+}
+
+return $loader;
+PHP
+);
+
+echo 'vendor/: '.count($packages)." packages recorded, temporary autoloader written\n";
