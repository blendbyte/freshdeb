+func createMockUIDir(t *testing.T) string {
+	t.Helper()
+	tmpDir := t.TempDir()
+
+	writeFile := func(relPath, content string, compressed bool) {
+		absPath := filepath.Join(tmpDir, relPath)
+		err := os.MkdirAll(filepath.Dir(absPath), 0755)
+		require.NoError(t, err)
+
+		if compressed {
+			// Write .gz
+			var buf bytes.Buffer
+			gw := gzip.NewWriter(&buf)
+			_, err = gw.Write([]byte(content))
+			require.NoError(t, err)
+			require.NoError(t, gw.Close())
+			err = os.WriteFile(absPath+".gz", buf.Bytes(), 0644)
+			require.NoError(t, err)
+
+			// Write .br
+			err = os.WriteFile(absPath+".br", []byte("br:"+content), 0644)
+			require.NoError(t, err)
+		} else {
+			err = os.WriteFile(absPath, []byte(content), 0644)
+			require.NoError(t, err)
+		}
+	}
+
+	writeFile("index.html", `<html><head><link rel="icon" href="favicon.ico"><script src="assets/main.js"></script></head></html>`, true)
+	writeFile("favicon.ico", "ico-data", true)
+	writeFile("assets/main.js", "console.log();", true)
+	writeFile("assets/font.woff", "woff-data", false)
+
+	return tmpDir
+}
