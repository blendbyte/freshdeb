--- a/cli/root_others.go
+++ b/cli/root_others.go
@@ -31,8 +31,11 @@ func defaultConfigFiles() []string {
 		systemConfigDir = filepath.SplitList(envConfigDir)[0]
 	}
 
+	// Debian's locations, then upstream's; a user's before the system's.
 	return []string{
+		filepath.Join(userConfigDir, "prometheus", "amtool.yml"),
 		filepath.Join(userConfigDir, "amtool", "config.yml"),
+		filepath.Join(systemConfigDir, "prometheus", "amtool.yml"),
 		filepath.Join(systemConfigDir, "amtool", "config.yml"),
 	}
 }
