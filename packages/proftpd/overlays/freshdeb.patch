--- a/debian/proftpd-core.NEWS
+++ b/debian/proftpd-core.NEWS
@@ -1,3 +1,33 @@
+proftpd-dfsg (1.3.9e-1) unstable; urgency=medium
+
+  freshdeb: changes since the distributions' 1.3.7c/1.3.8 that may need a
+  look before or after upgrading:
+   * mod_ls and mod_xfer are now loadable modules (see the 1.3.9~dfsg-2
+     entry below). The postinst adds "LoadModule mod_ls.c" and
+     "LoadModule mod_xfer.c" to /etc/proftpd/modules.conf; here it also
+     does so when you keep a locally changed modules.conf, since proftpd
+     won't start without them. Keep both lines if you edit the file.
+   * TLSOptions NoCertRequest was removed and is now a configuration
+     error; MultilineRFC2228 is deprecated (a warning) and can go.
+   * mod_tls no longer requests TLS renegotiations by default
+     (TLSRenegotiate), and the minimum DH parameter size is 2048 bits.
+   * FSCachePolicy is now off by default.
+   * When started as root, proftpd drops all supplemental groups and keeps
+     only the configured User/Group.
+   * Clients are disconnected when they can't be added to the
+     ScoreboardFile; ScoreboardOptions AllowMissingEntry restores the old
+     behaviour.
+   * mod_sftp uses "strict KEX" against the Terrapin attack
+     (CVE-2023-48795); SFTPOptions NoStrictKex turns it off for clients
+     that can't cope.
+   * mod_auth_otp requires an entry for each user; AuthOTPOptions
+     OptionalTableEntry makes entries optional again.
+   * ftpasswd writes SHA-256 password hashes by default instead of MD5.
+  Upstream's release notes have every change:
+  /usr/share/doc/proftpd-core/RELEASE_NOTES.gz
+
+ -- freshdeb <packages@freshdeb.com>  Wed, 28 Oct 2026 12:00:00 +0000
+
 proftpd-dfsg (1.3.9~dfsg-2) unstable; urgency=high
 
     The modules mod_ls.c & mod_xfer.c are built as modules and are needed to
diff -ruN a/debian/proftpd-core.postinst b/debian/proftpd-core.postinst
--- a/debian/proftpd-core.postinst
+++ b/debian/proftpd-core.postinst
@@ -84,22 +84,31 @@
     fi
 }
 
-add_mod_ls()
+# freshdeb: also matches indented or commented lines (Debian's pattern
+# matched any line starting with a space), and works without ModulePath.
+load_module()
 {
-    if [ -f $MODULES_NEW ] ; then
-	if ! egrep -qi "^[[:space:]]|#*LoadModule mod_ls.c" $MODULES_NEW ; then
-		perl -pi -e "s{^(ModulePath .*)}{\1\n# Debian #1103154: needed to make default config executable\n#\nLoadModule mod_ls.c\n}i;" $MODULES_NEW
-	fi
+    file=$1
+    mod=$2
+    [ -f "$file" ] || return 0
+    if grep -Eqi "^[[:space:]]*#*[[:space:]]*LoadModule[[:space:]]+$mod" "$file" ; then
+	return 0
+    fi
+    if grep -Eqi "^[[:space:]]*ModulePath[[:space:]]" "$file" ; then
+	perl -pi -e "s{^([[:space:]]*ModulePath .*)}{\1\n# Debian #1103154: needed to make default config executable\n#\nLoadModule $mod\n}i;" "$file"
+    else
+	printf '\n# Debian #1103154: needed to make default config executable\n#\nLoadModule %s\n' "$mod" >>"$file"
     fi
 }
 
+add_mod_ls()
+{
+    load_module $MODULES_NEW mod_ls.c
+}
+
 add_mod_xfer()
 {
-    if [ -f $MODULES_NEW ] ; then
-	if ! egrep -qi "^[[:space:]]|#*LoadModule mod_xfer.c" $MODULES_NEW ; then
-		perl -pi -e "s{^(ModulePath .*)}{\1\n# Debian #1103154: needed to make default config executable\n#\nLoadModule mod_xfer.c\n}i;" $MODULES_NEW
-	fi
-    fi
+    load_module $MODULES_NEW mod_xfer.c
 }
 
 replace_file () {
@@ -186,6 +195,14 @@
     # propose maintainer changes to user
     do_update /etc/proftpd/proftpd.conf
     do_update /etc/proftpd/modules.conf
+    # freshdeb: proftpd won't start without these, so add them even when
+    # ucf kept a locally changed modules.conf.
+    for mod in mod_ls.c mod_xfer.c ; do
+	if ! grep -Eqi "^[[:space:]]*#*[[:space:]]*LoadModule[[:space:]]+$mod" $MODULES ; then
+	    load_module $MODULES $mod
+	    echo "proftpd-core: added LoadModule $mod to $MODULES"
+	fi
+    done
     do_update /etc/proftpd/tls.conf
     do_update /etc/proftpd/sql.conf
     do_update /etc/proftpd/ldap.conf
