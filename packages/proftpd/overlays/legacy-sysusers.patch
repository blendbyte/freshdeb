+# freshdeb: this release's debhelper has no dh_installsysusers, so the users
+# are created here, as Debian did before 1.3.9a~dfsg-1.
+add_sysusers()
+{
+    if ! getent passwd ftp > /dev/null ; then
+	adduser --quiet --system --home /srv/ftp ftp
+    fi
+    if ! getent passwd proftpd > /dev/null ; then
+	adduser --quiet --system --disabled-login --no-create-home --home /run/proftpd proftpd
+    fi
+}
