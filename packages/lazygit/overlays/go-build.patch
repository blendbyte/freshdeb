--- a/debian/rules
+++ b/debian/rules
@@ -2,32 +2,48 @@
 
 include /usr/share/dpkg/pkg-info.mk
 
-export DH_GOLANG_EXCLUDES := scripts/*
-export DH_GOLANG_INSTALL_EXTRA := pkg/i18n/translations/ja.json \
-                                  pkg/i18n/translations/pl.json \
-                                  pkg/i18n/translations/ru.json \
-                                  pkg/i18n/translations/ko.json \
-                                  pkg/i18n/translations/pt.json \
-                                  pkg/i18n/translations/zh-CN.json \
-                                  pkg/i18n/translations/nl.json \
-                                  pkg/i18n/translations/zh-TW.json
-export DH_GOLANG_BUILDPKG := github.com/jesseduffield/lazygit
-
-BUILDFLAGS := -ldflags="-extldflags -Wl,-z,now -X main.version='$(DEB_VERSION)' -X main.buildSource='debian'"
-ifneq ($(shell dpkg-architecture -qDEB_HOST_ARCH), mips64el)
-BUILDFLAGS += -buildmode=pie
-endif
+# freshdeb: built with a pinned Go toolchain and vendored, checksum-verified
+# modules instead of dh-golang and Debian's golang-* packages, which older
+# releases don't have, with the flags and version stamps of upstream's
+# release binaries (.goreleaser.yml). The toolchain, offline mode
+# (GOFLAGS=-mod=vendor, GOPROXY=off) and caches come from the build
+# environment.
+export CGO_ENABLED := 0
+
+# The upstream commit, from the changelog entry freshdeb adds.
+REVISION   := $(or $(shell sed -n '1,/^ -- /s/.*(commit \([0-9a-f]\{40\}\)).*/\1/p' debian/changelog),unknown)
+BUILD_DATE := $(shell date --utc --date='@$(SOURCE_DATE_EPOCH)' +%Y-%m-%dT%H:%M:%SZ)
+# buildSource: upstream's releases say "binaryRelease"; lazygit's self-update
+# only runs for "buildBinary", so with ours apt stays in charge.
+BUILDFLAGS := -ldflags "\
+    -X main.version=$(DEB_VERSION_UPSTREAM)\
+    -X main.commit=$(REVISION)\
+    -X main.date=$(BUILD_DATE)\
+    -X main.buildSource=freshdeb"
 
 %:
-	dh $@ --buildsystem=golang --with=golang
-
-override_dh_auto_build:
-	dh_auto_build -- $(BUILDFLAGS)
+	dh $@
 
 override_dh_auto_configure:
 	# Generate manpage from template using @DEB_VERSION@ for package version
 	sed "s/@DEB_VERSION@/$(DEB_VERSION)/" debian/manpages/lazygit.1.in > debian/manpages/lazygit.1
-	dh_auto_configure
+
+override_dh_auto_build:
+	go version
+	go build $(BUILDFLAGS) -o _build/bin/lazygit .
+
+# Upstream's unit tests, as its CI runs them: -short skips the integration
+# tests, which drive lazygit in a terminal.
+override_dh_auto_test:
+ifeq (,$(filter nocheck,$(DEB_BUILD_OPTIONS)))
+	HOME=$$(mktemp -d) go test -short ./...
+endif
 
 override_dh_auto_install:
-	dh_auto_install -- --no-source
+	install -D -m 0755 _build/bin/lazygit debian/lazygit/usr/bin/lazygit
+
+# Go binary: nothing for dwz to compress.
+override_dh_dwz:
+
+override_dh_auto_clean:
+	rm -rf _build debian/manpages/lazygit.1
