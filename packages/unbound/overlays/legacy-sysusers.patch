diff -ruN a/debian/control b/debian/control
--- a/debian/control
+++ b/debian/control
@@ -9,7 +9,6 @@
  autoconf,
  bison,
  dh-apparmor <!pkg.unbound.libonly>,
- dh-sequence-installsysusers <!pkg.unbound.libonly>,
  dh-sequence-python3 <!pkg.unbound.libonly>,
  dpkg-dev (>= 1.16.1~),
  flex,
@@ -80,6 +79,7 @@
 Architecture: any
 Pre-Depends: ${misc:Pre-Depends}
 Depends:
