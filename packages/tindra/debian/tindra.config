#!/bin/sh
set -e

. /usr/share/debconf/confmodule

CONF=/etc/tindra/tindra.env

# The configuration file is the source of truth: questions that debconf has
# no answer for yet (its database was lost, say) start from its values.
value() {
    sed -n "s/^$1=//p" "$CONF" 2>/dev/null | tail -n 1
}
from_file() {
    db_fget "tindra/$1" seen
    if [ "$RET" = false ] && [ -n "$2" ]; then
        db_set "tindra/$1" "$2"
    fi
}
if [ -f "$CONF" ]; then
    from_file public_url "$(value PUBLIC_URL)"
    case "$(value BIND_ADDR)" in
        127.0.0.1:*) from_file port "$(value BIND_ADDR | sed 's/.*://')" ;;
        :*|0.0.0.0:*) from_file port "$(value BIND_ADDR | sed 's/.*://')"; from_file local_proxy false ;;
    esac
fi

db_input high tindra/public_url || true
db_input medium tindra/port || true
db_input medium tindra/local_proxy || true
db_go || true

db_get tindra/local_proxy
if [ "$RET" = false ]; then
    db_input medium tindra/trusted_proxies || true
    db_go || true
fi

# The database, until the configuration has one.
if [ -z "$(value DATABASE_URL)" ]; then
    db_input high tindra/local_database || true
    db_go || true
    db_get tindra/local_database
    if [ "$RET" = false ]; then
        db_input high tindra/database_url || true
        db_go || true
    fi
fi

# The first account, until postinst has created one.
if [ ! -e /var/lib/tindra/.debconf-account-created ]; then
    db_input high tindra/admin_email || true
    db_go || true
    db_get tindra/admin_email
    if [ -n "$RET" ]; then
        db_input high tindra/admin_name || true
        while db_input high tindra/admin_password; do
            db_go || true
            db_get tindra/admin_password
            [ "${#RET}" -ge 12 ] && break
            db_input critical tindra/password_too_short || true
            db_fset tindra/admin_password seen false
        done
        db_go || true
    fi
fi
