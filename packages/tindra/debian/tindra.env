# Tindra's configuration (dotenv). dpkg-reconfigure tindra manages the keys
# below; every other option (email, SSO, retention, limits) can be added and
# is kept: see /usr/share/doc/tindra/examples/env.example.
PUBLIC_URL=
BIND_ADDR=127.0.0.1:8080
TRUSTED_PROXIES=127.0.0.1,::1
COOKIE_SECURE=false
DATABASE_URL=
DATA_DIR=/var/lib/tindra
