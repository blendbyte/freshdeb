#!/bin/sh
set -e

case "$1" in
  purge)
    # Nothing is removed: /etc/forgejo/app.ini holds the secrets (SECRET_KEY)
    # that parts of /var/lib/forgejo are encrypted with, so the configuration
    # stays with the repositories and the database, and the git user stays
    # too (README.Debian).
  ;;

  remove|upgrade|failed-upgrade|abort-install|abort-upgrade|disappear)
  ;;

  *)
    echo "postrm called with unknown argument '$1'" >&2
    exit 1
  ;;
esac

#DEBHELPER#

exit 0
