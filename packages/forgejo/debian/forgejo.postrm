#!/bin/sh
set -e

case "$1" in
  purge)
    # The configuration goes with the package; repositories, the database
    # and everything else in /var/lib/forgejo, and the git user, stay.
    rm -f /etc/forgejo/app.ini
    rmdir /etc/forgejo 2>/dev/null || true
  ;;

  remove|upgrade|failed-upgrade|abort-install|abort-upgrade|disappear)
  ;;

  *)
    echo "postrm called with unknown argument '$1'" >&2
    exit 1
  ;;
esac

#DEBHELPER#

exit 0
